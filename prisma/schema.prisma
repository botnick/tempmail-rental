// TempMail SaaS - Prisma Schema
// Config-driven, audit-heavy, RBAC-enabled

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// USERS & AUTH
// ──────────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  publicId        String     @unique @default(cuid()) @map("public_id")
  email           String     @unique
  displayName     String?    @map("display_name")
  avatarUrl       String?    @map("avatar_url")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  metadata        Json?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  credential    UserCredential?
  sessions      Session[]
  userRoles     UserRole[]
  subscriptions Subscription[]
  wallet        Wallet?
  mailboxes     Mailbox[]
  domains       Domain[]
  auditLogs     AuditLog[]      @relation("AuditActor")
  riskEvents    RiskEvent[]
  supportNotes  SupportNote[]
  contentPages  ContentPage[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
  DEACTIVATED
}

model UserCredential {
  id                String    @id @default(cuid())
  userId            String    @unique @map("user_id")
  passwordHash      String    @map("password_hash")
  totpSecret        String?   @map("totp_secret")
  totpEnabled       Boolean   @default(false) @map("totp_enabled")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at")
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model Session {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  tokenHash        String    @unique @map("token_hash")
  refreshTokenHash String?   @unique @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  lastActiveAt     DateTime  @default(now()) @map("last_active_at")
  revokedAt        DateTime? @map("revoked_at")
  isAdmin          Boolean   @default(false) @map("is_admin")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ──────────────────────────────────────────────
// RBAC
// ──────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String   @map("display_name")
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  displayName String   @map("display_name")
  description String?
  module      String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  roleId    String    @map("role_id")
  grantedBy String?   @map("granted_by")
  grantedAt DateTime  @default(now()) @map("granted_at")
  expiresAt DateTime? @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ──────────────────────────────────────────────
// PLANS & SUBSCRIPTIONS
// ──────────────────────────────────────────────

model Plan {
  id          String     @id @default(cuid())
  publicId    String     @unique @default(cuid()) @map("public_id")
  slug        String     @unique
  name        String
  description String?
  status      PlanStatus @default(ACTIVE)
  isDefault   Boolean    @default(false) @map("is_default")
  sortOrder   Int        @default(0) @map("sort_order")
  trialDays   Int        @default(0) @map("trial_days")
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  features      PlanFeature[]
  pricing       PlanPricing[]
  subscriptions Subscription[]

  @@map("plans")
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  GRANDFATHERED
  SCHEDULED
}

model PlanFeature {
  id         String   @id @default(cuid())
  planId     String   @map("plan_id")
  featureKey String   @map("feature_key")
  value      String // JSON-encoded value for flexibility
  valueType  String   @default("number") @map("value_type") // number, boolean, string, json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([featureKey])
  @@map("plan_features")
}

model PlanPricing {
  id            String   @id @default(cuid())
  planId        String   @map("plan_id")
  currency      String   @default("USD")
  amount        Decimal  @db.Decimal(12, 2)
  billingPeriod String   @map("billing_period") // monthly, yearly, one_time
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currency, billingPeriod])
  @@map("plan_pricing")
}

model Subscription {
  id                 String             @id @default(cuid())
  publicId           String             @unique @default(cuid()) @map("public_id")
  userId             String             @map("user_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  canceledAt         DateTime?          @map("canceled_at")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  metadata           Json?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
  PAUSED
}

// ──────────────────────────────────────────────
// BILLING & WALLET
// ──────────────────────────────────────────────

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("USD")
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger WalletLedger[]

  @@map("wallets")
}

model WalletLedger {
  id             String     @id @default(cuid())
  walletId       String     @map("wallet_id")
  type           LedgerType
  amount         Decimal    @db.Decimal(12, 2)
  balanceBefore  Decimal    @map("balance_before") @db.Decimal(12, 2)
  balanceAfter   Decimal    @map("balance_after") @db.Decimal(12, 2)
  description    String?
  referenceType  String?    @map("reference_type")
  referenceId    String?    @map("reference_id")
  idempotencyKey String?    @unique @map("idempotency_key")
  createdBy      String?    @map("created_by")
  createdAt      DateTime   @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([referenceType, referenceId])
  @@map("wallet_ledger")
}

enum LedgerType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
  GRANT
}

model Topup {
  id             String      @id @default(cuid())
  publicId       String      @unique @default(cuid()) @map("public_id")
  userId         String      @map("user_id")
  amount         Decimal     @db.Decimal(12, 2)
  currency       String      @default("USD")
  status         TopupStatus @default(PENDING)
  paymentMethod  String?     @map("payment_method")
  externalId     String?     @map("external_id")
  idempotencyKey String      @unique @map("idempotency_key")
  metadata       Json?
  completedAt    DateTime?   @map("completed_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("topups")
}

enum TopupStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model Invoice {
  id        String        @id @default(cuid())
  publicId  String        @unique @default(cuid()) @map("public_id")
  userId    String        @map("user_id")
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("USD")
  status    InvoiceStatus @default(DRAFT)
  lineItems Json?         @map("line_items")
  issuedAt  DateTime?     @map("issued_at")
  dueAt     DateTime?     @map("due_at")
  paidAt    DateTime?     @map("paid_at")
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  transactions PaymentTransaction[]

  @@index([userId])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELED
  REFUNDED
}

model PaymentTransaction {
  id             String        @id @default(cuid())
  invoiceId      String?       @map("invoice_id")
  topupId        String?       @map("topup_id")
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD")
  status         PaymentStatus @default(PENDING)
  provider       String // stripe, paddle, manual
  externalId     String?       @map("external_id")
  idempotencyKey String        @unique @map("idempotency_key")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([externalId])
  @@map("payment_transactions")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
}

// ──────────────────────────────────────────────
// MAILBOXES
// ──────────────────────────────────────────────

model Mailbox {
  id           String        @id @default(cuid())
  publicId     String        @unique @default(cuid()) @map("public_id")
  userId       String        @map("user_id")
  address      String        @unique
  domainId     String?       @map("domain_id")
  status       MailboxStatus @default(ACTIVE)
  expiresAt    DateTime?     @map("expires_at")
  riskScore    Int           @default(0) @map("risk_score")
  messageCount Int           @default(0) @map("message_count")
  metadata     Json?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain   Domain?          @relation(fields: [domainId], references: [id])
  aliases  MailboxAlias[]
  messages MailboxMessage[]
  events   MailboxEvent[]

  @@index([userId])
  @@index([domainId])
  @@index([expiresAt])
  @@index([status])
  @@map("mailboxes")
}

enum MailboxStatus {
  ACTIVE
  EXPIRED
  QUARANTINED
  DELETED
  SUSPENDED
}

model MailboxAlias {
  id        String   @id @default(cuid())
  mailboxId String   @map("mailbox_id")
  alias     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@map("mailbox_aliases")
}

model MailboxMessage {
  id          String   @id @default(cuid())
  publicId    String   @unique @default(cuid()) @map("public_id")
  mailboxId   String   @map("mailbox_id")
  fromAddress String   @map("from_address")
  subject     String?
  bodyText    String?  @map("body_text")
  bodyHtml    String?  @map("body_html")
  headers     Json?
  size        Int      @default(0)
  isRead      Boolean  @default(false) @map("is_read")
  receivedAt  DateTime @default(now()) @map("received_at")
  createdAt   DateTime @default(now()) @map("created_at")

  mailbox     Mailbox             @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  attachments MailboxAttachment[]

  @@index([mailboxId, receivedAt])
  @@map("mailbox_messages")
}

model MailboxAttachment {
  id          String   @id @default(cuid())
  messageId   String   @map("message_id")
  filename    String
  contentType String   @map("content_type")
  size        Int
  storageKey  String   @map("storage_key")
  scanStatus  String   @default("pending") @map("scan_status") // pending, clean, malicious
  createdAt   DateTime @default(now()) @map("created_at")

  message MailboxMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("mailbox_attachments")
}

model MailboxEvent {
  id        String   @id @default(cuid())
  mailboxId String   @map("mailbox_id")
  type      String // created, expired, deleted, quarantined, extended, message_received
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([mailboxId, createdAt])
  @@map("mailbox_events")
}

// ──────────────────────────────────────────────
// DOMAINS
// ──────────────────────────────────────────────

model Domain {
  id        String       @id @default(cuid())
  publicId  String       @unique @default(cuid()) @map("public_id")
  name      String       @unique
  userId    String?      @map("user_id") // null = system domain
  status    DomainStatus @default(PENDING)
  isSystem  Boolean      @default(false) @map("is_system")
  catchAll  Boolean      @default(false) @map("catch_all")
  metadata  Json?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  user          User?                @relation(fields: [userId], references: [id])
  verifications DomainVerification[]
  policies      DomainPolicy[]
  mailboxes     Mailbox[]

  @@index([userId])
  @@map("domains")
}

enum DomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model DomainVerification {
  id          String    @id @default(cuid())
  domainId    String    @map("domain_id")
  recordType  String    @map("record_type") // TXT, CNAME, MX
  recordName  String    @map("record_name")
  recordValue String    @map("record_value")
  verified    Boolean   @default(false)
  verifiedAt  DateTime? @map("verified_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@map("domain_verifications")
}

model DomainPolicy {
  id          String   @id @default(cuid())
  domainId    String   @map("domain_id")
  policyKey   String   @map("policy_key")
  policyValue String   @map("policy_value")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, policyKey])
  @@map("domain_policies")
}

// ──────────────────────────────────────────────
// CONFIG & FEATURE FLAGS
// ──────────────────────────────────────────────

model ConfigEntry {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String // JSON-encoded
  valueType   String   @default("string") @map("value_type")
  category    String   @default("general")
  description String?
  isSecret    Boolean  @default(false) @map("is_secret")
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("config_entries")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  rolloutPct  Int      @default(0) @map("rollout_pct") // 0-100
  targetRoles Json?    @map("target_roles") // string[]
  targetPlans Json?    @map("target_plans") // string[]
  targetUsers Json?    @map("target_users") // string[]
  metadata    Json?
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

// ──────────────────────────────────────────────
// SECURITY & AUDIT
// ──────────────────────────────────────────────

model RiskEvent {
  id         String    @id @default(cuid())
  userId     String?   @map("user_id")
  type       String // brute_force, suspicious_signup, account_takeover, abuse
  severity   String    @default("medium") // low, medium, high, critical
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  metadata   Json?
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([severity])
  @@index([createdAt])
  @@map("risk_events")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actorType  String   @default("user") @map("actor_type") // user, system, admin
  action     String // e.g. user.login, mailbox.create, admin.user.suspend
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  before     Json? // snapshot before change
  after      Json? // snapshot after change
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  reason     String? // required for destructive admin actions
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AdminAction {
  id               String    @id @default(cuid())
  adminId          String    @map("admin_id")
  action           String
  targetType       String?   @map("target_type")
  targetId         String?   @map("target_id")
  reason           String
  requiresApproval Boolean   @default(false) @map("requires_approval")
  approvedBy       String?   @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([adminId])
  @@index([action])
  @@map("admin_actions")
}

model SupportNote {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  authorId  String   @map("author_id")
  content   String
  type      String   @default("note") // note, escalation, resolution
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("support_notes")
}

// ──────────────────────────────────────────────
// CMS, SEO, & DISCOVERY (AEO / GEO)
// ──────────────────────────────────────────────

model ContentPage {
  id              String    @id @default(cuid())
  slug            String // e.g., 'features', 'pricing', 'temp-mail-for-otp'
  locale          String    @default("en") // 'en', 'th'
  type            String    @default("page") // homepage, feature, pricing, blog, faq
  status          String    @default("draft") // draft, review, published, archived
  title           String?
  metaDescription String?   @map("meta_description")
  canonicalUrl    String?   @map("canonical_url")
  publishedAt     DateTime? @map("published_at")
  lastReviewedAt  DateTime? @map("last_reviewed_at")
  authorId        String?   @map("author_id")
  indexable       Boolean   @default(true) // For noindex
  metadata        Json? // Optional OG tags, snippets overrides, Twitter cards
  schemaType      String?   @map("schema_type") // e.g. 'FAQPage', 'Article'
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  author   User?                @relation(fields: [authorId], references: [id])
  versions ContentPageVersion[]
  blocks   ContentBlock[]

  @@unique([slug, locale])
  @@index([type])
  @@index([status])
  @@index([locale, status])
  @@map("content_pages")
}

model ContentPageVersion {
  id            String   @id @default(cuid())
  pageId        String   @map("page_id")
  versionNumber Int      @map("version_number")
  title         String?
  content       Json // Snapshot of blocks
  metadata      Json? // Snapshot of SEO Metadata
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  page ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, versionNumber])
  @@map("content_page_versions")
}

model ContentBlock {
  id        String   @id @default(cuid())
  pageId    String   @map("page_id")
  type      String // hero, faq, feature, trust, summary, comparison
  order     Int      @default(0)
  content   Json // The actual text/structure of the block
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  page ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
  @@map("content_blocks")
}

model AnswerBlock {
  id         String    @id @default(cuid())
  question   String
  answerText String    @map("answer_text") // Clean text for AI summary
  answerHtml String?   @map("answer_html") // Rich formatting
  locale     String    @default("en")
  intent     String? // definition, task, limitation
  status     String    @default("draft") // draft, published
  version    Int       @default(1)
  reviewedAt DateTime? @map("reviewed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([locale])
  @@index([intent])
  @@map("answer_blocks")
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  locale    String   @default("en")
  category  String? // pricing, features, general, security
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([locale])
  @@index([category])
  @@map("faq_items")
}

model GlossaryTerm {
  id          String   @id @default(cuid())
  term        String
  slug        String
  locale      String   @default("en")
  definition  String // Short answer for GEO/Snippets
  description String? // Long explanation
  relatedIds  Json?    @map("related_ids") // Array of related GlossaryTerm IDs
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([slug, locale])
  @@map("glossary_terms")
}

model KeywordCluster {
  id        String   @id @default(cuid())
  name      String // e.g. "disposable email"
  locale    String   @default("en")
  keywords  Json // Array of strings
  intentId  String?  @map("intent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  intent IntentCluster? @relation(fields: [intentId], references: [id])

  @@index([locale])
  @@map("keyword_clusters")
}

model IntentCluster {
  id          String   @id @default(cuid())
  name        String // e.g. "commercial", "trust", "comparison"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  keywordClusters KeywordCluster[]

  @@map("intent_clusters")
}

model InternalLinkModule {
  id        String   @id @default(cuid())
  name      String // e.g. "Footer Explainer Links", "Pricing Details"
  locale    String   @default("en")
  links     Json // Array of { href, label, title }
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("internal_link_modules")
}

model Redirect {
  id              String   @id @default(cuid())
  sourcePath      String   @unique @map("source_path")
  destinationPath String   @map("destination_path")
  isPermanent     Boolean  @default(true) @map("is_permanent") // 308/301 vs 307/302
  isActive        Boolean  @default(true) @map("is_active")
  description     String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([sourcePath])
  @@map("redirects")
}

model StructuredDataEntry {
  id         String   @id @default(cuid())
  schemaType String   @map("schema_type") // e.g. "Organization", "WebSite"
  payload    Json // The actual JSON-LD object to inject
  locale     String?  @default("en")
  isGlobal   Boolean  @default(false) @map("is_global") // If true, applies to all pages
  pageSlug   String?  @map("page_slug") // If provided, applies to a specific page
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([schemaType])
  @@index([pageSlug, locale])
  @@map("structured_data_entries")
}
